<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="760 540">
    <!-- Radiant sector: purpose-built surgical console layout. -->
    <BoxContainer Orientation="Horizontal" Margin="12" SeparationOverride="14"
                  HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer MinWidth="270" VerticalExpand="True" StyleClasses="AngleRect">
            <BoxContainer Orientation="Vertical" Margin="12" HorizontalAlignment="Center">
                <Label Text="{Loc body-scanner-patient-view}" StyleClasses="LabelHeading"
                       HorizontalAlignment="Center" />
                <PanelContainer StyleClasses="LowDivider" Margin="0 6 0 12" />
                <SpriteView Name="PatientSprite" OverrideDirection="South" Scale="4 4"
                            SetSize="240 330" HorizontalAlignment="Center" />
                <TextureRect Name="NoPatientTexture" Visible="False" SetSize="128 128"
                             HorizontalAlignment="Center" Stretch="KeepAspectCentered"
                             TexturePath="/Textures/Interface/Misc/health_analyzer_out_of_range.png" />
                <BoxContainer Name="PatientRotationControls" Orientation="Horizontal" SeparationOverride="8"
                              HorizontalAlignment="Center" Margin="0 0 0 6">
                    <Button Name="RotatePatientLeftButton" Text="‹" MinSize="42 28" />
                    <Button Name="RotatePatientRightButton" Text="›" MinSize="42 28" />
                </BoxContainer>
                <Label Name="PatientName" SetWidth="240" Align="Center" HorizontalAlignment="Center" ClipText="False" />
                <Label Name="PatientSpecies" SetWidth="240" Align="Center" StyleClasses="LabelSubText" HorizontalAlignment="Center" ClipText="False" />
                <Label Name="ConnectionState" Margin="0 6 0 0" HorizontalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <PanelContainer HorizontalExpand="True" VerticalExpand="True" StyleClasses="AngleRect">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="14">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <Label Text="{Loc body-scanner-overview-title}" StyleClasses="LabelHeading" />
                    <PanelContainer StyleClasses="LowDivider" Margin="0 6" />
                    <GridContainer Columns="2" Margin="0 4 0 8">
                        <Label Text="{Loc health-analyzer-window-entity-status-text}" />
                        <Label Name="StatusLabel" />
                        <Label Text="{Loc health-analyzer-window-entity-temperature-text}" />
                        <Label Name="TemperatureLabel" />
                        <Label Text="{Loc health-analyzer-window-entity-blood-level-text}" />
                        <Label Name="BloodLabel" />
                        <Label Text="{Loc health-analyzer-window-entity-damage-total-text}" />
                        <Label Name="DamageLabel" />
                    </GridContainer>

                    <BoxContainer Name="BleedingAlert" Visible="False" Orientation="Vertical">
                        <Label Text="{Loc body-scanner-active-bleeding}" FontColorOverride="#ff4a4a" />
                    </BoxContainer>

                    <Label Text="{Loc body-scanner-surgical-title}" StyleClasses="LabelHeading" Margin="0 14 0 0" />
                    <PanelContainer StyleClasses="LowDivider" Margin="0 6" />
                    <BoxContainer Name="SurgicalDiagnostics" Orientation="Vertical" SeparationOverride="5" />
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
