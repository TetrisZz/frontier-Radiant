<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'weapon-registration-window-title'}"
                      MinSize="380 220">
    <!--
        Weapon registration console window.
        A copy of the PDA fragment summary (weapon / serial / rarity / owner),
        but the owner is EDITABLE here: LineEdit + Save button.
        The PDA stays read-only — it only displays the owner from the server
        snapshot.
        SetWidth on the content box is load-bearing: a control's own SetWidth
        also caps the width it offers to its children, so the RichTextLabels
        below measure against 360px and WRAP. Without it they would be measured
        with unlimited width, and since the window only has MinSize (no upper
        bound) a long owner name would stretch the window to the right instead of
        wrapping onto the next line.
    -->
    <BoxContainer Orientation="Vertical" Margin="8" SetWidth="360" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="EmptyHint"
               Text="{Loc 'weapon-registration-empty-hint'}"
               Align="Center" VAlign="Center"
               HorizontalExpand="True" VerticalExpand="True"
               FontColorOverride="DarkGray" />
        <BoxContainer Name="SummaryBox" Orientation="Vertical" Visible="False" HorizontalExpand="True">
            <RichTextLabel Name="DetailWeapon" />
            <RichTextLabel Name="DetailSerial" />
            <RichTextLabel Name="DetailClass" />
            <RichTextLabel Name="DetailOrigin" />
            <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 5"/>
            <RichTextLabel Name="DetailOwner" />
            <LineEdit Name="OwnerEdit" Visible="False" PlaceHolder="{Loc 'weapon-registry-owner-placeholder'}"/>
            <Button Name="SaveOwnerButton" Visible="False" Text="{Loc 'weapon-registry-owner-save'}" Margin="0 5 0 0"/>
            <Button Name="StampButton" Visible="False" Text="{Loc 'weapon-registration-stamp'}" Margin="0 5 0 0"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
