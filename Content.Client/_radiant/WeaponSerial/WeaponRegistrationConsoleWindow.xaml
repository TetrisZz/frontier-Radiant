<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'weapon-registration-window-title'}"
                      MinSize="380 220">
    <!--
        Weapon registration console window.
        A copy of the PDA fragment summary (weapon / serial / rarity / owner),
        but the owner is EDITABLE here: LineEdit + Save button.
        The PDA stays read-only — it only displays the owner from the server
        snapshot.
    -->
    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="EmptyHint"
               Text="{Loc 'weapon-registration-empty-hint'}"
               Align="Center" VAlign="Center"
               HorizontalExpand="True" VerticalExpand="True"
               FontColorOverride="DarkGray" />
        <BoxContainer Name="SummaryBox" Orientation="Vertical" Visible="False" HorizontalExpand="True">
            <RichTextLabel Name="DetailWeapon" />
            <RichTextLabel Name="DetailSerial" />
            <RichTextLabel Name="DetailRarity" />
            <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 5"/>
            <RichTextLabel Name="DetailOwner" />
            <LineEdit Name="OwnerEdit" PlaceHolder="{Loc 'weapon-registry-owner-placeholder'}"/>
            <Button Name="SaveOwnerButton" Text="{Loc 'weapon-registry-owner-save'}" Margin="0 5 0 0"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
