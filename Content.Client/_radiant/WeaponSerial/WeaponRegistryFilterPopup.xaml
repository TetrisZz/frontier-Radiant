<ui:WeaponRegistryFilterPopup
        xmlns="https://spacestation14.io"
        xmlns:ui="clr-namespace:Content.Client._radiant.WeaponSerial"
        MinWidth="210">
    <!--
        Filter window of the OSK weapon registry program: sort order + origin.
        A small popup that floats OVER the PDA window: it is parented to the UI
        modal root, so it is drawn on top of everything and closes as soon as the
        player clicks anywhere else. The option buttons are generated in code (from
        WeaponRegistrySortMode and the origins found in the registry), so a new
        order or a new origin means a loc string at most, not editing this file.
    -->
    <PanelContainer StyleClasses="BorderedWindowPanel">
        <BoxContainer Orientation="Vertical" Margin="6">
            <Label Text="{Loc 'weapon-registry-filter-title'}" HorizontalAlignment="Center"/>
            <PanelContainer StyleClasses="LowDivider" Margin="0 4 0 4"/>
            <Label Text="{Loc 'weapon-registry-filter-sort-title'}" HorizontalAlignment="Center"/>
            <PanelContainer StyleClasses="LowDivider" Margin="0 2 0 2"/>
            <BoxContainer Name="OptionsContainer" Orientation="Vertical" SeparationOverride="2"/>
            <PanelContainer StyleClasses="LowDivider" Margin="6 4 6 4"/>
            <Label Text="{Loc 'weapon-registry-filter-origin-title'}" HorizontalAlignment="Center"/>
            <PanelContainer StyleClasses="LowDivider" Margin="0 2 0 2"/>
            <BoxContainer Name="OriginsContainer" Orientation="Vertical" SeparationOverride="2"/>
        </BoxContainer>
    </PanelContainer>
</ui:WeaponRegistryFilterPopup>
