<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    x:Class="Content.Client.Interaction.Panel.Ui.InteractionPanelMenu"
    Title="{Loc 'interaction-ui-default-title'}"
    MinSize="620 620"
    SetSize="640 740">

    <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="4">
        <!-- Верхний блок информации -->
        <BoxContainer Name="UpperBlock" HorizontalExpand="True" Margin="0, 2, 0, 6">
            <PanelContainer Name="UserCard" HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#202C36" BorderColor="#344958" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                    <BoxContainer Name="UserNameRow" HorizontalExpand="True" />
                    <PanelContainer MinHeight="1">
                        <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#344958" /></PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Name="UserSpriteView" Orientation="Horizontal" SeparationOverride="10" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer Name="TargetCard" HorizontalExpand="True" Margin="8, 0, 0, 0" Visible="False">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#202C36" BorderColor="#344958" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                    <BoxContainer Name="TargetNameRow" HorizontalExpand="True" />
                    <PanelContainer MinHeight="1">
                        <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#344958" /></PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Name="TargetSpriteView" Orientation="Horizontal" SeparationOverride="10" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4, 2, 4, 4">
            <Label Text="{Loc 'interaction-panel-arousal-label'}" StyleClasses="LabelSubText" />
            <ProgressBar Name="ArousalBar" MinValue="0" MaxValue="1" Value="0" HorizontalExpand="True" SetHeight="10">
                <ProgressBar.ForegroundStyleBoxOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#E85A8A" />
                </ProgressBar.ForegroundStyleBoxOverride>
            </ProgressBar>
            <CheckBox Name="HideFromOthersCheckBox"
                      Text="Скрыть от окружающих (видим только мы)"
                      Margin="0, 4, 0, 0"/>
            <CheckBox Name="SoloModeCheckBox"
                      Text="{Loc 'interaction-panel-solo-mode'}"
                      Margin="0, 4, 0, 0"/>
        </BoxContainer>

        <!-- Специальный блок -->
        <BoxContainer Margin="0, 4">
            <Button Name="FavoritesOnlyButton" Text="{Loc 'interaction-panel-filter-favorites'}" ToggleMode="True" />
            <CheckBox Name="AvailableOnlyCheckBox" Text="{Loc 'interaction-panel-filter-available'}" Margin="8, 0" />
            <Control HorizontalExpand="True" />
            <Button Name="ManagementButton" Text="{Loc 'interaction-panel-management'}" ToggleMode="True" />
        </BoxContainer>
        <BoxContainer Name="ManagementPanel" Orientation="Vertical" Visible="False">
            <BoxContainer HorizontalExpand="True">
                <Button Name="ImportButton" HorizontalExpand="True" Text="{Loc 'interaction-panel-import-button'}"/>
                <Button Name="ConstructorButton" HorizontalExpand="True" Text="{Loc 'interaction-panel-constructor-button'}"/>
            </BoxContainer>
            <Label Text="{Loc 'interaction-panel-edit-imported'}" />
            <ScrollContainer MaxHeight="160" HScrollEnabled="False">
                <BoxContainer Name="EditorsContainer" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <BoxContainer Margin="4">
            <LineEdit Name="SearchBar" HorizontalExpand="True" PlaceHolder="{Loc 'interaction-panel-search-placeholder'}"/>
            <Button Name="ClearSearchButton" Text="{Loc 'interaction-panel-search-clear'}" />
        </BoxContainer>
        <Label Name="SearchResults" StyleClasses="LabelSubText" />
        <Label Text="{Loc 'interaction-panel-unavailable-hint'}" StyleClasses="LabelSubText" />
        <Label Name="EmptyResults" Text="{Loc 'interaction-panel-search-empty'}" Visible="False" />

        <!-- Контейнер для взаимодействия -->
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#80808005" />
            </PanelContainer.PanelOverride>

            <ScrollContainer Name="Scroll" HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer Name="InteractionContainer" Orientation="Vertical" VerticalExpand="True">

                    <!-- Первая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Special" Title="{Loc 'interaction-panel-special-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True"  />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="SpecialContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Вторая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Favourites" Title="{Loc 'interaction-panel-favourites-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="FavouritesContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Третья разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Lips" Title="{Loc 'interaction-panel-lips-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="LipsContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Hands" Title="{Loc 'interaction-panel-hands-collapsible'}" MinWidth="480" MinHeight="32" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="HandsContainer" Orientation="Vertical" SeparationOverride="5" />
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Четвертая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Head" Title="{Loc 'interaction-panel-head-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="HeadContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Пятая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Chest" Title="{Loc 'interaction-panel-chest-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="ChestContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Шестая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Groin" Title="{Loc 'interaction-panel-groin-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="GroinContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Седьмая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Tail" Title="{Loc 'interaction-panel-tail-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="TailContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>

                    <!-- Восьмая разворачивающаяся панель -->
                    <Collapsible Orientation="Vertical" Margin="0, 0, 0, 8">
                        <CollapsibleHeading Name="Body" Title="{Loc 'interaction-panel-body-collapsible'}" MinWidth="480" MinHeight="32" HorizontalAlignment="Stretch" HorizontalExpand="True" />
                        <CollapsibleBody Margin="0, 5, 0, 0">
                            <BoxContainer Name="BodyContainer" Orientation="Vertical" SeparationOverride="5">
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
