ent-RadiantWaterPipe = water pipe (four-way)
    .desc = Connects to adjacent water pipes and equipment on the same tile.
ent-RadiantWastePipe = wastewater pipe (four-way)
    .desc = Carries wastewater to a connected tank.
ent-RadiantWaterPipeHalf = water pipe (end piece)
    .desc = { ent-RadiantWaterPipe.desc }
ent-RadiantWaterPipeStraight = water pipe (straight)
    .desc = { ent-RadiantWaterPipe.desc }
ent-RadiantWaterPipeBend = water pipe (bend)
    .desc = { ent-RadiantWaterPipe.desc }
ent-RadiantWaterPipeTJunction = water pipe (T-junction)
    .desc = { ent-RadiantWaterPipe.desc }
ent-RadiantWastePipeHalf = wastewater pipe (end piece)
    .desc = { ent-RadiantWastePipe.desc }
ent-RadiantWastePipeStraight = wastewater pipe (straight)
    .desc = { ent-RadiantWastePipe.desc }
ent-RadiantWastePipeBend = wastewater pipe (bend)
    .desc = { ent-RadiantWastePipe.desc }
ent-RadiantWastePipeTJunction = wastewater pipe (T-junction)
    .desc = { ent-RadiantWastePipe.desc }
ent-RadiantWaterSupplyTank = ship water supply tank
    .desc = Holds 5000 units. Accepts only water and keeps its contents when the shuttle is saved. Place a water pipe beneath it.
ent-RadiantWastewaterTank = ship wastewater tank
    .desc = Holds 5000 units. Place a wastewater pipe beneath it. An empty container can be used to drain it; wastewater is cleared when saving the shuttle.
ent-RadiantPlumbedSink = plumbed sink
    .desc = Adds clean water to open containers. Use the context menu to empty a container into the drain.
ent-RadiantPlumbedShower = plumbed shower
    .desc = Runs on water from a connected tank. Place a water pipe on the shower's tile.
ent-RadiantShower = shower
    .desc = { ent-RadiantPlumbedShower.desc }
ent-RadiantPlumbedDrain = plumbed floor drain
    .desc = Collects puddles and sends the liquid to a wastewater tank.
ent-RadiantPlumbedToilet = plumbed toilet
    .desc = The bowl is flushed with water from the supply line and empties into the wastewater tank.
