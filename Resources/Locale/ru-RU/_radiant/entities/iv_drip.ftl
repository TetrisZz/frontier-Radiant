ent-RadiantIVDrip = капельница
    .desc = Передвижная стойка для внутривенных вливаний и забора крови. Вставьте пакет и перетащите стойку на пациента. ПКМ — режим и доза, ЛКМ пустой рукой — отсоединить.
ent-RadiantIVDripTelescopic = телескопическая капельница
    .desc = Компактная стойка для внутривенных вливаний и забора крови. Вставьте пакет и перетащите стойку на пациента. ПКМ — режим и доза, ЛКМ пустой рукой — отсоединить.

ent-RadiantIVBag = пакет для капельницы
    .desc = Многоразовый медицинский пакет на 200 единиц раствора. Наполняется из ёмкостей или шприцем; подходит для капельниц.
    .suffix = Пустой
ent-RadiantIVBagBlood = { ent-RadiantIVBag }
    .desc = { ent-RadiantIVBag.desc }
    .suffix = Кровь, Полный

