uniform highp vec3 color1;
uniform highp vec3 color2;
// 0=L→R, 1=R→L, 2=T→B, 3=B→T, 4=TL→BR, 5=BL→TR
uniform highp float direction;
uniform highp float brightness;

void fragment() {
    highp vec4 base = zTexture(UV);
    highp float t;

    if (direction < 0.5) {
        t = UV2.x;
    } else if (direction < 1.5) {
        t = 1.0 - UV2.x;
    } else if (direction < 2.5) {
        t = UV2.y;
    } else if (direction < 3.5) {
        t = 1.0 - UV2.y;
    } else if (direction < 4.5) {
        t = (UV2.x + UV2.y) * 0.5;
    } else {
        t = (UV2.x + (1.0 - UV2.y)) * 0.5;
    }

    highp vec3 boostedColor2 = min(color2 * brightness, vec3(1.0));
    highp vec3 gradient = mix(color1, boostedColor2, clamp(t, 0.0, 1.0));
    COLOR = vec4(base.rgb * gradient, base.a);
}
