uniform sampler2D SCREEN_TEXTURE;
uniform highp vec3 tintColor; // Radiant Sector

void fragment() {
    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, UV);

    highp mat3 m = mat3(
        vec3(0.000,1.000,0.000),
        vec3(0.000,0.000,1.000),
        vec3(-0.165,0.165,1.000)
    );
    highp vec3 result = color.rgb * m;
    result = mix(result, result * tintColor, 0.55); // Radiant Sector: shadowkin eye-colour tint.

    COLOR = vec4(result, 1);
}
